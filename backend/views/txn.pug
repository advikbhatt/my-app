extends layout

block content
  .rside
    .formwrap.container-fluid
      // Payment Form
      form(method='POST' action='/sendtoairpay' class='form-horizontal' name='make_trans' id='make_trans')
        .row
          // Buyer Email
          .col-md-6.col-lg-4
            .form-group
              label(for='buyerEmail') Buyer Email
                font.red *<br/>
              input#buyerEmail.form-control(type='email', name='buyerEmail', required)

          // Buyer Phone
          .col-md-6.col-lg-4
            .form-group
              label(for='buyerPhone') Buyer Phone
                font.red *<br/>
              input#buyerPhone.form-control(type='text', name='buyerPhone', required, maxlength='10')

          // Buyer First Name
          .col-md-6.col-lg-4
            .form-group
              label(for='buyerFirstName') Buyer First Name
                font.red *<br/>
              input#buyerFirstName.form-control(type='text', name='buyerFirstName', required)

          // Buyer Last Name
          .col-md-6.col-lg-4
            .form-group
              label(for='buyerLastName') Buyer Last Name
                font.red *<br/>
              input#buyerLastName.form-control(type='text', name='buyerLastName', required)

        hr

        .row
          // Auto-generated Order ID
          .col-md-6.col-lg-4
            .form-group
              label(for='orderid') Order ID
                font.red *<br/>
              input#orderid.form-control(type='text', name='orderid', readonly)

          // Fixed Amount (₹1)
          .col-md-6.col-lg-4
            .form-group
              label(for='amount') Amount
                font.red *<br/>
              input#amount.form-control(type='text', name='amount', value='1', readonly)

          // Currency
          .col-md-6.col-lg-4
            .form-group
              label(for='currency') Currency
                font.red *<br/>
              input#currency.form-control(type='text', name='currency', value='356', readonly)

          // ISO Currency
          .col-md-6.col-lg-4
            .form-group
              label(for='isocurrency') ISO Currency
                font.red *<br/>
              input#isocurrency.form-control(type='text', name='isocurrency', value='INR', readonly)

        hr

        // Submit button
        .btngroup
          button.btn.btn-primary(type='submit') Pay ₹1

  // ✅ Inline script to auto-generate random order ID
  script.
    function generateOrderId() {
      const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const digits = '0123456789';
      let part1 = '';
      let part2 = '';
      for (let i = 0; i < 6; i++) {
        part1 += letters.charAt(Math.floor(Math.random() * letters.length));
      }
      for (let i = 0; i < 4; i++) {
        part2 += digits.charAt(Math.floor(Math.random() * digits.length));
      }
      return part1 + part2;
    }

    document.addEventListener('DOMContentLoaded', function() {
      document.getElementById('orderid').value = generateOrderId();
    });
